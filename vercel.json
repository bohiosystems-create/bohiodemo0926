{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/whatsapp.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/contractor-portal.html"
    },
    {
      "source": "/schedule",
      "destination": "/schedule.html"
    },
    {
      "source": "/programme",
      "destination": "/schedule.html"
    }
  ],
  "headers": [
    {
      "source": "/reports/(.*).pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
# --- Required for live Outlook (otherwise runs in demo mode) ---
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=replace_with_client_secret_value
MS_TENANT_ID=common            # or your tenant ID to restrict to your organisation
PUBLIC_BASE_URL=https://your-app.onrender.com   # no trailing slash; redirect URI = PUBLIC_BASE_URL/auth/callback

# --- Recommended ---
ANTHROPIC_API_KEY=sk-ant-...   # Claude parses free-text enquiries and quotes (falls back to rules if unset)
APP_PASSWORD=choose-a-strong-password
SESSION_SECRET=long-random-string
BUSINESS_NAME=Bohio                # name printed on invoices (editable in Settings)
SENDER_NAME=Your Name | Bohio

# --- Optional ---
PORT=3000
DATA_DIR=./data                # mount a persistent disk here in production
SENDS_PER_MINUTE=25            # Exchange Online allows max 30 messages/min per mailbox
SEED_DEMO=true                 # load 8 demo suppliers on first run (never emailed once Outlook is live)
CLAUDE_MODEL=claude-opus-5-5
